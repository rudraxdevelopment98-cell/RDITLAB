# Vercel Postgres — auto-populated when you add Postgres storage in Vercel dashboard
# For local dev: run `vercel env pull .env.local` to download these
POSTGRES_PRISMA_URL="postgresql://user:password@host-pooler:5432/database?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/database"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRY=24

# Admin credentials used to seed the initial account on first deploy
ADMIN_EMAIL="admin@rditlab.co.uk"
ADMIN_PASSWORD="ChangeMe123!"

# Public URL of the deployment (used in password-reset links)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Email notifications via Resend (optional — skipped if RESEND_API_KEY is unset)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="no-reply@rditlab.co.uk"
ALERT_EMAIL="admin@rditlab.co.uk"
