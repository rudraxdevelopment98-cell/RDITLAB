# PostgreSQL Configuration
# For Vercel: Get POSTGRES_URL from Vercel Postgres dashboard
# For local: postgresql://user:password@localhost:5432/database_name
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRY=24

# Admin Credentials (change immediately in production)
ADMIN_EMAIL="admin@rditlab.co.uk"
ADMIN_PASSWORD="ChangeMe123!"

# API URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Email Notifications via Resend (optional — email is skipped if RESEND_API_KEY is unset)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="no-reply@rditlab.co.uk"
ALERT_EMAIL="admin@rditlab.co.uk"
