// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String   // Hashed password
  name               String?
  role               String   @default("admin")
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  auditLogs AuditLog[]
}

model Page {
  id        String   @id @default(cuid())
  title     String
  section   String   // 'hero', 'about', 'services', 'contact'
  content   String   // Long text content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  
  // Unique constraint on title per section
  @@unique([title, section])
}

// Editable site copy for the public home page, keyed by section
// ('hero' | 'about' | 'services' | 'contact' | 'footer'). Value is a JSON blob
// matching the shape in src/lib/content.ts, deep-merged over code defaults.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
  createdBy String?
}

// Launched products shown on the Products page & home teaser (admin-managed).
// Media (film / preview / poster) default to /public/products/<slug>.* but can
// be overridden with explicit URLs (e.g. uploaded blobs or external hosts).
model Launch {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  tagline     String
  description String
  features    String   @default("") // newline-separated
  stack       String   @default("") // comma-separated
  liveUrl     String   @default("") // empty = private tool
  liveLabel   String   @default("")
  duration    Int      @default(0)  // seconds, shown on the play button
  accent      String   @default("#b45309")
  videoUrl    String   @default("") // overrides slug-based film path
  previewUrl  String   @default("") // overrides slug-based preview path
  posterUrl   String   @default("") // overrides slug-based poster path
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   // Long text biography
  image     String   // Image URL
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
}

model AuditLog {
  id        String   @id @default(cuid())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  action    String   // 'CREATE', 'UPDATE', 'DELETE'
  entity    String   // 'Page', 'TeamMember', 'Admin', 'Project', 'Plan', 'Template'
  entityId  String
  oldData   String?  // JSON string of old data
  newData   String?  // JSON string of new data
  createdAt DateTime @default(now())
}

// Web & Software Studio — portfolio projects (managed from admin)
model Project {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  tags        String   @default("") // comma-separated
  demoUrl     String   @default("#")
  image       String?  // optional thumbnail URL (overrides gradient)
  gradient    String   @default("from-violet-500 to-indigo-600")
  overview    String   @default("") // long-form case-study overview (markdown-ish)
  presentationUrl  String @default("") // link or uploaded file URL
  presentationType String @default("") // 'link' | 'file' | 'embed' | ''
  featured    Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
}

// Client testimonials (admin-managed + visitor submissions with approval)
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  company   String   @default("")
  photo     String?  // avatar / company logo URL
  rating    Int      @default(5)
  quote     String
  source    String   @default("admin") // 'admin' | 'visitor'
  approved  Boolean  @default(false)
  featured  Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
}

// Web & Software Studio — pricing plans (managed from admin)
model Plan {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  price     String
  period    String   @default("")
  features  String   @default("") // newline-separated
  cta       String   @default("Get started")
  popular   Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
}

// Web & Software Studio — starter templates (managed from admin)
model Template {
  id          String   @id @default(cuid())
  name        String
  category    String
  price       String   @default("Free")
  description String
  image       String?  // optional thumbnail URL (overrides gradient)
  gradient    String   @default("from-violet-500 to-indigo-600")
  previewUrl  String   @default("#")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
}
